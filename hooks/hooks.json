{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.optimus-session-start=!exec bash\" optimus-session-start \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start\" --git-alias",
            "async": false
          }
        ]
      }
    ]
  }
}
