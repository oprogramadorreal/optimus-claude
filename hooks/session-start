#!/usr/bin/env bash
set -euo pipefail

# Git runs shell aliases from the repository root and records the caller's
# relative directory in GIT_PREFIX. Only the fallback launcher needs this.
if [ "${1:-}" = "--git-alias" ] && [ -n "${GIT_PREFIX:-}" ]; then
  cd -- "$GIT_PREFIX"
fi

# SessionStart hook — outputs dynamic project state so Claude knows what's
# configured and what's missing. Only outputs items that need attention.
# Fully configured projects produce no output (zero context waste).
# Runs fast (~20-50ms — test -f, pruned find calls, and one git log).
# Working-tree status is NOT reported here — Claude Code injects its own
# gitStatus snapshot (branch, porcelain status, recent commits). That snapshot
# has NO upstream-divergence line, so unpushed commits are the one git signal
# this hook still reports: without it, local-only work from a previous session
# looks delivered.
#
# Host detection: Codex loads this plugin through the same hooks.json and sets
# PLUGIN_ROOT next to CLAUDE_PLUGIN_ROOT; Claude Code sets only the latter.
# Under Codex the skill mentions take the `$optimus:` form and one extra line
# names the plugin root, because Codex neither substitutes $CLAUDE_PLUGIN_ROOT
# in skill text nor offers an AskUserQuestion tool. Under Claude Code the
# output is unchanged.

output=""

# Codex sets PLUGIN_ROOT and CLAUDE_PLUGIN_ROOT to the same path; Claude Code
# sets only the latter. Requiring equality keeps a stray PLUGIN_ROOT in a
# user's shell from flipping the wording.
codex_host=""
if [ -n "${PLUGIN_ROOT:-}" ] && [ "${PLUGIN_ROOT}" = "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  codex_host=1
fi
skill_prefix="/optimus:"
setup_features="project context, coding guidelines, and auto-format hooks"
if [ -n "$codex_host" ]; then
  skill_prefix='$optimus:'
  setup_features="project context, coding guidelines, and test infrastructure"
fi

# Pruned marker search: find the first file matching the given -path pattern,
# skipping node_modules/.git at every level. No -mindepth: it would suppress
# the prune at depth 1, leaving the root node_modules/ and .git/ fully walked.
# The -path patterns used here already imply depth >= 2.
find_marker() {
  find . -maxdepth 4 \( -name node_modules -o -name .git \) -prune -o -path "$1" -print -quit 2>/dev/null || true
}

# 1. Check if optimus:init has been run
if [ ! -f .claude/CLAUDE.md ] || [ ! -f .claude/docs/coding-guidelines.md ]; then
  # Multi-repo workspace: init may live in a sub-repo's .claude/, not the workspace root.
  # .optimus-version is uniquely written by /optimus:init, so it's the authoritative marker.
  multi_repo_marker=$(find_marker '*/.claude/.optimus-version')
  if [ -z "$multi_repo_marker" ]; then
    output+="[optimus] Not initialized — no \`.claude/CLAUDE.md\` or \`.claude/docs/coding-guidelines.md\`. Suggest \`${skill_prefix}init\` to set up ${setup_features}."$'\n'
  fi
else
  # 2. Check test infrastructure (only relevant if init was done)
  if [ ! -f .claude/docs/testing.md ]; then
    # Check monorepo subprojects too
    has_testing=$(find_marker '*/docs/testing.md')
    if [ -z "$has_testing" ]; then
      output+="[optimus] Testing docs missing. Suggest re-running \`${skill_prefix}init\` to set up test infrastructure."$'\n'
    fi
  fi

fi

# 3. Unpushed commits — the one git signal gitStatus lacks (see header).
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  unpushed=$(git log --oneline '@{u}..HEAD' 2>/dev/null | wc -l | tr -d ' ') || unpushed=0
  [ "$unpushed" -gt 0 ] 2>/dev/null && output+="[optimus] ${unpushed} commits unpushed to upstream."$'\n'
fi

# 4. Check the installed path-restriction hook is current.
# templates/hooks/restrict-paths.sh is COPIED into a project by
# /optimus:permissions. Updating the plugin never re-copies it, so a project can
# keep running a hook that predates a security fix with nothing to say so. The
# HOOK_VERSION line in each copy makes that drift visible. Silent unless the
# project actually has the hook installed and the plugin's copy is newer.
# Result in a global, and read with the shell rather than sed. This runs TWICE
# on every session start, and the version marker sits in the first few lines —
# but `v="$(sed ... | head -1)"` scanned all 1400+ of them behind three forks
# (subshell + sed + head) per call. On Windows, where a fork is expensive and
# nothing else on this path pays for one, those six forks were most of the
# hook's runtime. A bounded read costs none of them.
_hook_version=0
read_hook_version() { # $1=file -> sets _hook_version; no marker means pre-versioning
  local v="" line n=0
  # Bounded by STRUCTURE — the banner comment the marker lives in — not by a
  # line count. A literal bound was wrong in the SILENT direction: push the
  # marker one line past it in the TEMPLATE and `want` reads 0, which
  # `[ "$want" -gt "$have" ]` can never satisfy, so the staleness warning stops
  # existing for every project instead of failing loudly. It was also a magic
  # number duplicated in scripts/validate.sh. Stopping at the first line that is
  # not a comment costs nothing in the normal case (the loop still breaks on the
  # marker itself, eight lines in); the counter is only a runaway guard for a
  # file that is comments all the way down.
  while [ "$n" -lt 500 ] && IFS= read -r line; do
    n=$((n + 1))
    case "$line" in
      '# HOOK_VERSION:'*)
        v="${line#*:}"
        v="${v#"${v%%[![:space:]]*}"}"   # trim the space after the colon
        v="${v%%[![:digit:]]*}"          # keep the leading digit run only
        break
        ;;
      '#'*|'') ;;                        # shebang, banner, blank — keep reading
      *) break ;;                        # first line of code: the banner is over
    esac
  done < "$1" 2>/dev/null || v=""
  # Strip leading zeros: `[ 010 -gt 8 ]` evaluates 010 as OCTAL. No extglob needed.
  while [ "${#v}" -gt 1 ] && [ "${v#0}" != "$v" ]; do v="${v#0}"; done
  # Clamp absurd values: `[ -gt ]` writes "integer expected" to stderr on every
  # session start for anything past int64, and the check would silently do nothing.
  [ "${#v}" -gt 9 ] && v="999999999"
  _hook_version="${v:-0}"
}

# CLAUDE_PLUGIN_ROOT cannot be the gate here: it reads empty on some platforms
# (notably Windows), and gating on it turned this whole check into a silent
# no-op exactly where a stale hook is as likely as anywhere. This script lives
# at <plugin-root>/hooks/session-start, so its own location is authoritative;
# the env var stays as an override for an installation that relocates it.
plugin_root="${CLAUDE_PLUGIN_ROOT:-}"
if [ -z "$plugin_root" ]; then
  # Pure parameter expansion, not `cd "$(dirname ...)" && pwd` + `dirname`:
  # plugin_root is only ever used to OPEN the file below, so it does not have to
  # be canonical — '<dir>/hooks/..' opens exactly what the resolved path would.
  # A relative BASH_SOURCE resolves against the same CWD either way.
  case "${BASH_SOURCE[0]}" in
    */*) plugin_root="${BASH_SOURCE[0]%/*}/.." ;;
    *)   plugin_root=".." ;;
  esac
fi

installed_hook=".claude/hooks/restrict-paths.sh"
template_hook="$plugin_root/skills/permissions/templates/hooks/restrict-paths.sh"
if [ -z "$codex_host" ] && [ -f "$installed_hook" ] && [ -f "$template_hook" ]; then
  read_hook_version "$installed_hook"; have="$_hook_version"
  read_hook_version "$template_hook"; want="$_hook_version"
  if [ "$want" -gt "$have" ]; then
    output+="[optimus] The path-restriction hook installed in this project (\`.claude/hooks/restrict-paths.sh\`, v$have) is older than the plugin's (v$want) and may be missing security fixes. Suggest re-running \`${skill_prefix}permissions\` to update it."$'\n'
  fi
fi

# 5. Codex context line — emitted even for a fully configured project, because
# it carries the plugin root every skill resolves $CLAUDE_PLUGIN_ROOT through.
if [ -n "$codex_host" ]; then
  output+="[optimus] Running under Codex. Plugin root: ${PLUGIN_ROOT} — skill text calls it \$CLAUDE_PLUGIN_ROOT. Map skill mentions from /optimus:<skill> to \$optimus:<skill>. Where a skill says AskUserQuestion, ask in plain text with numbered options and wait for the answer."$'\n'
  output+="[optimus] Under Codex, skip the Claude-only permissions and dream skills, formatter installation, and /goal or /workflows handoffs; report the limitation. Claude-specific plan-mode handoff instructions require manual adaptation."$'\n'
fi

# Only output if there's something to report
[ -n "$output" ] && printf '%s' "$output"

exit 0
